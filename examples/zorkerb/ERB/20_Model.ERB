; Native ERB helpers. Invocation-local variables MUST be DYNAMIC.
@Z_HAS(Z_O, Z_MASK)
#FUNCTION
#DIM DYNAMIC Z_O
#DIM DYNAMIC Z_MASK
SIF Z_O <= 0 || Z_O > Z_OBJECT_COUNT
    RETURNF 0
RETURNF (Z_FLAGS:Z_O & Z_MASK) != 0

@Z_WITHIN(Z_O, Z_ANCESTOR)
#FUNCTION
#DIM DYNAMIC Z_O
#DIM DYNAMIC Z_ANCESTOR
#DIM DYNAMIC Z_P
#DIM DYNAMIC Z_GUARD
Z_P = Z_O
FOR Z_GUARD, 0, Z_OBJECT_COUNT
    SIF Z_P <= 0 || Z_P > Z_OBJECT_COUNT
        RETURNF 0
    Z_P = Z_PARENT:Z_P
    SIF Z_P == Z_ANCESTOR
        RETURNF 1
NEXT
RETURNF 0

; GET-OBJECT's SEARCH-LIST: only the object's own INVISIBLE bit matters;
; the search descends into any open container, visible or not.
@Z_PARSER_REACH(Z_O, Z_TOUCH)
#FUNCTION
#DIM DYNAMIC Z_O
#DIM DYNAMIC Z_TOUCH
#DIM DYNAMIC Z_P
#DIM DYNAMIC Z_GUARD
SIF Z_O <= 0 || Z_O > Z_OBJECT_COUNT
    RETURNF 0
SIF Z_HAS(Z_O, ZF_HIDDEN)
    RETURNF 0
SIF Z_O == O_PSEUDO_OBJECT || Z_SCOPE_CLASS:Z_O == 3 || Z_SCOPE:Z_O:Z_HERE
    RETURNF Z_ACCESS(Z_O, Z_TOUCH)
Z_P = Z_O
FOR Z_GUARD, 0, Z_OBJECT_COUNT
    Z_P = Z_PARENT:Z_P
    SIF Z_P == Z_PLAYER || Z_P == Z_HERE
        RETURNF 1
    SIF Z_P <= 0 || Z_P > Z_OBJECT_COUNT
        RETURNF 0
    IF !Z_HAS(Z_P, ZF_OPEN) && !Z_HAS(Z_P, ZF_SURFACE)
        SIF Z_TOUCH || !Z_HAS(Z_P, ZF_TRANSPARENT)
            RETURNF 0
    ENDIF
NEXT
RETURNF 0

@Z_ACCESS(Z_O, Z_TOUCH)
#FUNCTION
#DIM DYNAMIC Z_O
#DIM DYNAMIC Z_TOUCH
#DIM DYNAMIC Z_P
#DIM DYNAMIC Z_GUARD
SIF Z_O <= 0 || Z_O > Z_OBJECT_COUNT
    RETURNF 0
SIF Z_HAS(Z_O, ZF_HIDDEN)
    RETURNF 0
SIF Z_O == O_PSEUDO_OBJECT
    RETURNF Z_PSEUDO_ACTION > 0
SIF Z_SCOPE_CLASS:Z_O == 3
    RETURNF 1
SIF Z_SCOPE:Z_O:Z_HERE
    RETURNF 1
Z_P = Z_O
FOR Z_GUARD, 0, Z_OBJECT_COUNT
    Z_P = Z_PARENT:Z_P
    SIF Z_P == Z_PLAYER || Z_P == Z_HERE
        RETURNF 1
    SIF Z_P <= 0 || Z_P > Z_OBJECT_COUNT
        RETURNF 0
    SIF Z_HAS(Z_P, ZF_HIDDEN)
        RETURNF 0
    IF !Z_HAS(Z_P, ZF_OPEN) && !Z_HAS(Z_P, ZF_SURFACE)
        SIF Z_TOUCH || !Z_HAS(Z_P, ZF_TRANSPARENT)
            RETURNF 0
    ENDIF
NEXT
RETURNF 0

@Z_IS_LIT()
#FUNCTION
RETURNF Z_IS_LIT_AT(Z_HERE)

@Z_IS_LIT_AT(Z_ROOM)
#FUNCTION
#DIM DYNAMIC Z_ROOM
#DIM DYNAMIC Z_LIGHT_OBJ
#DIM DYNAMIC Z_P
#DIM DYNAMIC Z_GUARD
SIF Z_DEAD
    RETURNF 1
SIF Z_ROOM == R_MAINTENANCE_ROOM && Z_MAINT_LIGHT
    RETURNF 1
SIF Z_ROOM_LIGHT:Z_ROOM || (Z_ROOM == R_GRATING_ROOM && Z_HAS(O_GRATE, ZF_OPEN))
    RETURNF 1
FOR Z_LIGHT_OBJ, 1, Z_OBJECT_COUNT + 1
    SIF !Z_HAS(Z_LIGHT_OBJ, ZF_ON) || Z_HAS(Z_LIGHT_OBJ, ZF_HIDDEN)
        CONTINUE
    Z_P = Z_LIGHT_OBJ
    FOR Z_GUARD, 0, Z_OBJECT_COUNT
        Z_P = Z_PARENT:Z_P
        SIF Z_P == Z_PLAYER || Z_P == Z_ROOM
            RETURNF 1
        SIF Z_P <= 0 || Z_P > Z_OBJECT_COUNT
            BREAK
        SIF Z_HAS(Z_P, ZF_HIDDEN) || (!Z_HAS(Z_P, ZF_OPEN) && !Z_HAS(Z_P, ZF_TRANSPARENT) && !Z_HAS(Z_P, ZF_SURFACE))
            BREAK
    NEXT
NEXT
RETURNF 0

@Z_LOAD_WEIGHT(Z_CONTAINER)
#FUNCTION
#DIM DYNAMIC Z_CONTAINER
#DIM DYNAMIC Z_O
#DIM DYNAMIC Z_TOTAL
; gverbs WEIGHT(PLAYER) includes ADVENTURER's default SIZE of 5.
; For containers this helper still returns contents only, as V-PUT subtracts
; the container's own SIZE before comparing with CAPACITY.
SIF Z_CONTAINER == Z_PLAYER
    Z_TOTAL = 5
FOR Z_O, 1, Z_OBJECT_COUNT + 1
    SIF Z_WITHIN(Z_O, Z_CONTAINER)
        Z_TOTAL += Z_SIZE:Z_O
NEXT
RETURNF Z_TOTAL

@Z_OBJECT_WEIGHT(Z_O)
#FUNCTION
#DIM DYNAMIC Z_O
RETURNF Z_SIZE:Z_O + Z_LOAD_WEIGHT(Z_O)

@Z_TOTAL_SCORE()
#FUNCTION
; SCORE-UPD changes SCORE and BASE-SCORE equally. The trophy contribution
; stays cached until LIVING-ROOM-FCN receives the relevant M-END action.
RETURNF Z_BASE_SCORE + Z_CASE_SCORE

@Z_CASE_TOTAL()
#FUNCTION
#DIM DYNAMIC Z_O
#DIM DYNAMIC Z_S
#DIM DYNAMIC Z_LINK_CURSOR1
Z_S = 0
; The original OTVAL-FROB adds direct trophy-case children. Its recursive call
; does not add the returned value. Do not silently 'fix' that source behaviour.
Z_LINK_CURSOR1 = Z_FIRST_CHILD(O_TROPHY_CASE)
WHILE Z_LINK_CURSOR1
    Z_O = Z_LINK_CURSOR1
    Z_LINK_CURSOR1 = Z_NEXT:Z_O
    SIF Z_PARENT:Z_O == O_TROPHY_CASE
        Z_S += Z_CURRENT_TVALUE:Z_O
WEND
RETURNF Z_S

@Z_TOUCH_TREE(Z_O)
#DIM DYNAMIC Z_O
#DIM DYNAMIC Z_I
Z_TOUCHED:Z_O = 1
FOR Z_I, 1, Z_OBJECT_COUNT + 1
    SIF Z_WITHIN(Z_I, Z_O)
        Z_TOUCHED:Z_I = 1
NEXT
RETURN

@Z_AWARD_TAKE(Z_O)
#DIM DYNAMIC Z_O
IF !Z_VALUE_AWARDED:Z_O
    Z_BASE_SCORE += Z_VALUE:Z_O
    Z_VALUE_AWARDED:Z_O = 1
    CALL Z_SCORE_UPDATED
ENDIF
RETURN

@Z_TRIM(Z_S)
#FUNCTIONS
#DIMS DYNAMIC Z_S
WHILE STRLENS(Z_S) > 0
    SIF SUBSTRING(Z_S, 0, 1) != " "
        BREAK
    Z_S '= SUBSTRING(Z_S, 1)
WEND
WHILE STRLENS(Z_S) > 0
    SIF SUBSTRING(Z_S, STRLENS(Z_S) - 1, 1) != " "
        BREAK
    Z_S '= SUBSTRING(Z_S, 0, STRLENS(Z_S) - 1)
WEND
RETURNF Z_S

@Z_NORMALIZE(Z_S)
#FUNCTIONS
#DIMS DYNAMIC Z_S
Z_S '= REPLACE(Z_S, "\t", " " )
Z_S '= Z_TRIM(TOLOWER(Z_S))
WHILE STRFIND(Z_S, "  ") >= 0
    Z_S '= REPLACE(Z_S, "  ", " ")
WEND
RETURNF Z_S

@Z_DIRECTION_ID(Z_S)
#FUNCTION
#DIMS DYNAMIC Z_S
SELECTCASE SUBSTRING(Z_S, 0, 6)
CASE "n", "north"
    RETURNF 0
CASE "e", "east"
    RETURNF 1
CASE "s", "south"
    RETURNF 2
CASE "w", "west"
    RETURNF 3
CASE "ne", "northe"
    RETURNF 4
CASE "nw", "northw"
    RETURNF 5
CASE "se", "southe"
    RETURNF 6
CASE "sw", "southw"
    RETURNF 7
CASE "u", "up"
    RETURNF 8
CASE "d", "down"
    RETURNF 9
CASE "in", "inside"
    RETURNF 10
CASE "out"
    RETURNF 11
ENDSELECT
RETURNF -1

; Mutable room flags needed by the thief and death scatterer.
@Z_ROOM_NATURAL_LIGHT(Z_ROOM)
#FUNCTION
#DIM DYNAMIC Z_ROOM
SIF Z_ROOM == R_MAINTENANCE_ROOM
    RETURNF Z_MAINT_LIGHT
SIF Z_ROOM == R_GRATING_ROOM && Z_HAS(O_GRATE, ZF_OPEN)
    RETURNF 1
RETURNF Z_ROOM_LIGHT:Z_ROOM

@Z_ROOM_IS_LAND(Z_ROOM)
#FUNCTION
#DIM DYNAMIC Z_ROOM
SIF Z_ROOM == R_RESERVOIR
    RETURNF Z_LOW_TIDE
RETURNF Z_ROOM_LAND:Z_ROOM

@Z_CASE_END_TURN
; Source LIVING-ROOM-FCN: TAKE (including an ordinary refusal), or PUT
; with the trophy case as PRSI. MUNG / OPEN / LOOK / SCORE do not refresh it.
SIF Z_HERE != R_LIVING_ROOM || Z_ABORT
    RETURN
IF Z_VERB == "take" || (Z_VERB == "put" && Z_IOBJ == O_TROPHY_CASE)
    Z_CASE_SCORE = Z_CASE_TOTAL()
    CALL Z_SCORE_UPDATED
ENDIF
RETURN
