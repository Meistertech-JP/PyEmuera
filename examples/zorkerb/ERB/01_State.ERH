; Mutable gameplay state. Only these fields form the versioned save contract.
#DIM SAVEDATA Z_YUKS_COUNT
#DIM SAVEDATA Z_YUKS_ORDER, 4
#DIM SAVEDATA Z_SAILOR_HELLO_COUNT
#DIM SAVEDATA Z_DUMMY_COUNT
#DIM SAVEDATA Z_DUMMY_ORDER, 3
#DIM SAVEDATA Z_HOHUM_COUNT
#DIM SAVEDATA Z_HOHUM_ORDER, 3
#DIM SAVEDATA Z_SCHEMA
; r29 Z-machine RANDOM mode (#RANDOM): sequential interval and counter.
#DIM SAVEDATA Z_RNG_INTERVAL
#DIM SAVEDATA Z_RNG_COUNTER
#DIM SAVEDATA Z_HERE
#DIM SAVEDATA Z_MOVES
#DIM SAVEDATA Z_BASE_SCORE
#DIM SAVEDATA Z_CASE_SCORE
#DIM SAVEDATA Z_PARENT, 256
#DIM SAVEDATA Z_FLAGS, 256
#DIM SAVEDATA Z_TOUCHED, 256
#DIM SAVEDATA Z_VALUE_AWARDED, 256
#DIM SAVEDATA Z_CURRENT_TVALUE, 256
#DIM SAVEDATA Z_VISITED, 512
#DIM SAVEDATA Z_ROOM_AWARDED, 512
#DIM SAVEDATA Z_IT
#DIM SAVEDATA Z_RUG_MOVED
#DIM SAVEDATA Z_GRATE_REVEALED
#DIM SAVEDATA Z_WINDOW_HANDLED
#DIM SAVEDATA Z_LAMP_TICKS
#DIM SAVEDATA Z_VERBOSE
#DIMS SAVEDATA Z_LAST_COMMAND
; Not game state: only used for a root-level transition to a fresh game.
#DIM GLOBAL Z_RESTART_REQUEST
; Read-only metadata, explicitly rebound after every successful load.
#DIMS Z_ROOM_NAME, 512
#DIMS Z_ROOM_DESC, 512
#DIM Z_ROOM_LIGHT, 512
#DIM Z_ROOM_POINTS, 512
#DIM Z_EXITS, 512, 12
#DIMS Z_EXIT_TEXT, 512, 12
#DIMS Z_OBJ_NAME, 256
#DIMS Z_NOUNS, 256
#DIMS Z_ADJECTIVES, 256
#DIMS Z_FDESC, 256
#DIMS Z_LDESC, 256
#DIMS Z_TEXT, 256
#DIM Z_SIZE, 256
#DIM Z_CAPACITY, 256
#DIM Z_VALUE, 256
#DIM Z_TVALUE, 256
#DIM Z_INITIAL_PARENT, 256
#DIM Z_INITIAL_FLAGS, 256
#DIM Z_SCOPE, 256, 512
; Source P?GLOBAL order per room. Read-only, restored on LOAD.
#DIM Z_ROOM_GLOBAL_COUNT, 512
#DIM Z_ROOM_GLOBALS, 512, 8
; Immutable ZIL parser metadata, NOT part of SAVE.
#DIM Z_SEARCHABLE, 256
; 1 LOCAL-GLOBAL, 2 room PSEUDO, 3 global object.
#DIM Z_SCOPE_CLASS, 256
; r12 syntax scope flags: gparser.zil SH SC SIR SOG (not SAVEDATA).
#DEFINE ZS_SH 128
#DEFINE ZS_SC 64
#DEFINE ZS_SIR 32
#DEFINE ZS_SOG 16
#DIM Z_RESOLVE_ROLE
#DIMS Z_NOTHERE_D
#DIMS Z_NOTHERE_I
#DIMS Z_NOTHERE_LIST, 64
; Transient parser/control state. Never rely on LOADDATA to clear these.
#DIMS Z_COMMAND
#DIMS Z_VERB
#DIMS Z_NOUN
#DIMS Z_OTHER_NOUN
#DIM Z_DOBJ
#DIM Z_IOBJ
#DIM Z_CONTROL
#DIM Z_SLOT
#DIM Z_VALID
#DIM Z_TIME
; gparser NUMBER? writes the most recently recognised numeric token.
#DIM Z_P_NUMBER
#DIM Z_ALL
; Subset of ALL matched by an optional following noun phrase.
#DIMS Z_ALL_FILTER
#DIM Z_DIRECTION
#DIM Z_ABORT
#DEFINE ZF_TAKE 1
#DEFINE ZF_CONTAINER 2
#DEFINE ZF_OPEN 4
#DEFINE ZF_TRANSPARENT 8
#DEFINE ZF_SURFACE 16
#DEFINE ZF_FIXED 32
#DEFINE ZF_DOOR 64
#DEFINE ZF_HIDDEN 128
#DEFINE ZF_LIGHT 256
#DEFINE ZF_ON 512
#DEFINE ZF_FOOD 1024
#DEFINE ZF_READ 2048
#DEFINE ZF_NDESC 4096
#DEFINE ZC_NONE 0
#DEFINE ZC_SAVE 1
#DEFINE ZC_LOAD 2
#DEFINE ZC_RESTART 3
#DEFINE ZC_QUIT 4

; r2 save schema: every combat/puzzle timer is explicit and portable.
#DIM SAVEDATA Z_TROLL_STRENGTH
#DIM SAVEDATA Z_TROLL_PASS
#DIM SAVEDATA Z_TROLL_FIGHT
#DIM SAVEDATA Z_TROLL_STAGGER
#DIM SAVEDATA Z_TROLL_WAKE
#DIM SAVEDATA Z_HERO_WOUND
#DIM SAVEDATA Z_HERO_STAGGER
#DIM SAVEDATA Z_CURE_TIMER
#DIM SAVEDATA Z_LOAD_LIMIT
#DIM SAVEDATA Z_GRATE_UNLOCKED
#DIM SAVEDATA Z_CYCLOPS_HUNGER
#DIM SAVEDATA Z_CYCLOPS_SLEEP
#DIM SAVEDATA Z_MAGIC_FLAG
#DIM SAVEDATA Z_GAME_OVER
#DIM SAVEDATA Z_SWORD_GLOW
; Textual melee tables are immutable and rebuilt on load.
#DIMS Z_HERO_REMARKS, 10, 8
#DIM Z_HERO_REMARK_COUNT, 10
#DIMS Z_TROLL_REMARKS, 10, 8
#DIM Z_TROLL_REMARK_COUNT, 10
#DEFINE ZF_WEAPON 8192
#DEFINE ZF_ACTOR 16384
#DIM SAVEDATA Z_CYCLOPS_ACTIVE

; Dam, mirror, dome, light and exorcism state.
#DIM SAVEDATA Z_GATE_ENABLED
#DIM SAVEDATA Z_GATES_OPEN
#DIM SAVEDATA Z_LOW_TIDE
#DIM SAVEDATA Z_DAM_TIMER
#DIM SAVEDATA Z_WATER_LEVEL
#DIM SAVEDATA Z_MAINT_LIGHT
#DIM SAVEDATA Z_LOUD_SOLVED
#DIM SAVEDATA Z_TROLL_LDESC
#DIM SAVEDATA Z_LOUD_LOOP
#DIM SAVEDATA Z_LOUD_DEFER
; P-LEXV entries 0..2 as the latest READ left them (Loud Room SAY). P-LEXV is
; dynamic memory, so the story's SAVE/RESTORE keeps them: they are saved too.
#DIMS SAVEDATA Z_LEXV_STALE, 3
#DIM SAVEDATA Z_DOME_TIED
#DIM SAVEDATA Z_MIRROR_BROKEN
#DIM SAVEDATA Z_MATCH_COUNT
#DIM SAVEDATA Z_MATCH_TIMER
#DIM SAVEDATA Z_CANDLE_TICKS
#DIM SAVEDATA Z_CANDLE_ACTIVE
#DIM SAVEDATA Z_EXORCISM_BELL
#DIM SAVEDATA Z_EXORCISM_CANDLES
#DIM SAVEDATA Z_XB_TIMER
#DIM SAVEDATA Z_XC_TIMER
#DIM SAVEDATA Z_HOTBELL_TIMER
#DIM SAVEDATA Z_LLD_OPEN
#DEFINE ZF_FLAME 32768
#DIM SAVEDATA Z_LUCKY
#DIM SAVEDATA Z_LOUD_COUNT
#DIM SAVEDATA Z_LOUD_ORDER, 3
#DEFINE ZF_SACRED 65536

; r3: River, rainbow and coal mine. Every puzzle clock survives save/restore.
#DIM SAVEDATA Z_IN_BOAT
#DIM SAVEDATA Z_RIVER_TIMER
#DIM SAVEDATA Z_RAINBOW
#DIM SAVEDATA Z_BUOY_HINT
#DIM SAVEDATA Z_BEACH_DIG
#DIM SAVEDATA Z_CAGE_TOP
#DIM SAVEDATA Z_SHAFT_SCORED
#DIM SAVEDATA Z_BAT_COUNT
#DIM SAVEDATA Z_BAT_ORDER, 8

; r4: thief, egg/canary, death continuation, and ending.
#DEFINE ZF_TOOL 131072
#DIM SAVEDATA Z_THIEF_STRENGTH
#DIM SAVEDATA Z_THIEF_ACTIVE
#DIM SAVEDATA Z_THIEF_HERE
#DIM SAVEDATA Z_THIEF_FIGHT
#DIM SAVEDATA Z_THIEF_STAGGER
#DIM SAVEDATA Z_THIEF_WAKE
#DIM SAVEDATA Z_THIEF_ENGROSSED
#DIM SAVEDATA Z_EGG_SOLVED
#DIM SAVEDATA Z_EGG_ATTEMPT
#DIM SAVEDATA Z_SING_SONG
#DIM SAVEDATA Z_DEATHS
#DIM SAVEDATA Z_DEAD
#DIM SAVEDATA Z_WON
#DIM SAVEDATA Z_FINISHED
#DIM SAVEDATA Z_LAMP_ENABLED
#DIM SAVEDATA Z_SWORD_ENABLED
#DIM Z_DEATH_THIS_TURN
; Room traversal metadata is rebuilt on load, never reinitializing gameplay.
#DIM Z_ROOM_NEXT, 512
#DIM Z_ROOM_LAND, 512
#DIM Z_ROOM_SACRED, 512
#DIM Z_ROOM_MAZE, 512
#DIM Z_ROOM_ORDER, 128
#DIM Z_ROOM_COUNT
#DIMS Z_THIEF_REMARKS, 10, 8
#DIM Z_THIEF_REMARK_COUNT, 10

; r5: persisted parser continuations. SAVE captures the unexecuted sentence tail.
#DIMS SAVEDATA Z_PENDING
#DIMS SAVEDATA Z_OOPS_COMMAND
#DIMS SAVEDATA Z_OOPS_PENDING
#DIM SAVEDATA Z_OOPS_START
#DIM SAVEDATA Z_OOPS_LENGTH
#DIM SAVEDATA Z_LAST_VALID
; Immutable dictionaries are rebuilt after load, just like world metadata.
#DIMS Z_REPLAY_NAME, 256
; Statement-local work: never persisted, never left stale by LOADDATA.
#DIM Z_LIST_COUNT
#DIM Z_LIST, 64
; r29 source lexical scan (37_SourceParser); rebuilt for every statement.
#DIMS Z_SP_WORD, 160
#DIMS Z_SP_KEY, 160
#DIM Z_SP_INFO, 160
#DIM Z_SP_N
#DIM Z_SP_PLEN
#DIM Z_SP_VERB
#DIM Z_SP_NCN
#DIM Z_SP_PREP1
#DIM Z_SP_PREP2
#DIM Z_SP_FOUND
#DIM Z_SP_LOC1
#DIM Z_SP_LOC2
#DIMS Z_SP_ACTION
#DIM Z_SRC_ATTR, 256
#DIMS Z_PT_DICT
#DIM Z_PT_DICT_INFO, 6000
#DIM Z_PT_SYN_N, 256
#DIM Z_PT_SYN_BITS, 4096
#DIM Z_PT_SYN_LOCS, 4096
#DIM Z_PT_SYN_GWIMS, 4096
#DIMS Z_PT_SYN_ACTIONS, 4096
#DIMS Z_PT_PREP_WORDS, 256
#DIM Z_SRC_EXIT_SIZE, 512, 13
#DIM Z_SRC_EXIT_DEST, 512, 13
#DIM Z_SP_DRIVEN
#DIM Z_SP_GWIM_D
#DIM Z_SP_GWIM_I
#DIMS Z_SP_ORPHAN_TEXT
#DIM Z_SP_END_ON_PREP
#DIM Z_SP_VERB_PTR
#DIMS Z_SP_IPREP
#DIMS Z_SP_ORPHAN_PREP
#DIM Z_SP_NC1_START
#DIM Z_SP_NC1_END
#DIM Z_SP_NC2_START
#DIM Z_SP_NC2_END
#DEFINE ZG_SOURCE_ATTR 1048576
#DIM Z_EXCLUDED, 256
#DIM Z_REPARSE
#DIMS Z_INPUT_REPLY
#DIMS Z_HISTORY_PREP
#DIM Z_WAS_AGAIN

; r8 source-level syntax constraints. Rebuilt metadata, not gameplay state.
#DIM Z_TRYTAKE, 256
#DIM Z_REQUIRE_D
#DIM Z_REQUIRE_I
#DIMS Z_SOURCE_VERB
#DIMS Z_HISTORY_HEAD

; r8 quoted actor continuation and source PICK-ONE state.
#DIM SAVEDATA Z_ACTOR
#DIMS SAVEDATA Z_ACTOR_PENDING
#DIM SAVEDATA Z_HELLO_COUNT
#DIM SAVEDATA Z_HELLO_ORDER, 4
#DIM Z_ORDER_ACTOR
#DIMS Z_SPEECH_BODY
#DIM Z_SPEECH_MODE
; r23: PRSA remains SAY during lexical failure, including later input lines.
#DIM SAVEDATA Z_AFTER_SAY
; Raw lexical continuation keeps closing quotes as delimiters, not text.
#DIM SAVEDATA Z_QUOTE_STREAM
#DIM SAVEDATA Z_OOPS_QUOTED
#DIM SAVEDATA Z_OOPS_ACTOR
#DIMS Z_CURRENT_STREAM

#DIM Z_BURNABLE, 256

; r8 dynamic clock: slots never move after first registration.
#DEFINE ZE_FIGHT 1
#DEFINE ZE_SWORD 2
#DEFINE ZE_THIEF 3
#DEFINE ZE_CANDLES 4
#DEFINE ZE_LANTERN 5
#DEFINE ZE_MATCH 6
#DEFINE ZE_XB 7
#DEFINE ZE_XC 8
#DEFINE ZE_XBH 9
#DEFINE ZE_RFILL 10
#DEFINE ZE_REMPTY 11
#DEFINE ZE_MAINT 12
#DEFINE ZE_RIVER 13
#DEFINE ZE_CYCLOPS 14
#DEFINE ZE_CURE 15
#DEFINE ZE_FOREST 16
#DIM SAVEDATA Z_Q_FIRST
#DIM SAVEDATA Z_Q_DEMONS
#DIM SAVEDATA Z_Q_ROUTINE, 30
#DIM SAVEDATA Z_Q_ENABLED, 30
#DIM SAVEDATA Z_Q_TICK, 30
#DIM SAVEDATA Z_CLOCK_WAIT
#DIM SAVEDATA Z_LAMP_STAGE
#DIM SAVEDATA Z_CANDLE_STAGE
#DIM Z_CLOCK_DEPTH

; r10: the source WHEEEEE/PICK-ONE table, independent of HELLOS.
; r25: JUMPLOSS is independent of WHEEEEE/HELLOS.
#DIM SAVEDATA Z_JUMP_COUNT
#DIM SAVEDATA Z_JUMP_ORDER, 3
#DIM SAVEDATA Z_SKIP_COUNT
#DIM SAVEDATA Z_SKIP_ORDER, 4

; r10: mutable object linkage. Player -1 maps to a dedicated head index.
#DEFINE Z_PLAYER_NODE 512
#DIM SAVEDATA Z_FIRST, 513
#DIM SAVEDATA Z_NEXT, 256
#DIM Z_INITIAL_ORDER, 256
#DIM Z_SCAN, 256
#DIM Z_SCAN_COUNT

; r16: statement-local candidate and inference scratch. Not persisted.
#DIM Z_CANDIDATES, 256
#DIM Z_CANDIDATE_COUNT
#DIM Z_INFER_D
#DIM Z_INFER_I
#DEFINE ZG_DRINK 262144
#DEFINE ZG_BURN 524288

; r28: gparser GLOBAL-CHECK mutates one PSEUDO-OBJECT, not one object per noun.
#DIM SAVEDATA Z_PSEUDO_ACTION
#DIMS SAVEDATA Z_PSEUDO_WORD
; Immutable ordered room P?PSEUDO property, rebound before validating saved state.
#DIM Z_PSEUDO_COUNT, 512
#DIMS Z_PSEUDO_KEYS, 512, 4
#DIM Z_PSEUDO_ACTIONS, 512, 4
; SNARFEM P-ONE (per noun clause) and member position for Z_RESOLVE.
#DIM Z_P_ONE
#DIM Z_RESOLVE_MEMBER
#DIM Z_P_ONE_LEN
