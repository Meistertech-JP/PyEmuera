; Packed word info: flags * 65536 + byte5 * 256 + byte6; -1 = not in vocabulary.
@Z_PT_INFO(Z_W)
#FUNCTION
#DIMS DYNAMIC Z_W
#DIM DYNAMIC Z_P
SIF Z_W == "" || STRFIND(Z_W, "|") >= 0
    RETURNF -1
Z_P = STRFIND(Z_PT_DICT, "|" + Z_W + "|")
SIF Z_P < 0
    RETURNF -1
RETURNF Z_PT_DICT_INFO:Z_P

@Z_PT_SYN_COUNT(Z_V)
#FUNCTION
#DIM DYNAMIC Z_V
SIF Z_V < 0 || Z_V > 255
    RETURNF 0
RETURNF Z_PT_SYN_N:Z_V

@Z_PT_SYN(Z_V, Z_K)
#FUNCTION
#DIM DYNAMIC Z_V
#DIM DYNAMIC Z_K
RETURNF Z_PT_SYN_BITS:(Z_V * 16 + Z_K)

@Z_PT_SYN_LOC(Z_V, Z_K)
#FUNCTION
#DIM DYNAMIC Z_V
#DIM DYNAMIC Z_K
RETURNF Z_PT_SYN_LOCS:(Z_V * 16 + Z_K)

@Z_PT_SYN_GWIM(Z_V, Z_K)
#FUNCTION
#DIM DYNAMIC Z_V
