Z_BURNABLE:O_INFLATABLE_BOAT = 1
Z_BURNABLE:O_PUNCTURED_BOAT = 1
Z_BURNABLE:O_BOAT_LABEL = 1
Z_BURNABLE:O_NEST = 1
