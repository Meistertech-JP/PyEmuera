; GCLOCK translation. Source gclock.zil @97b7b3d (1596 bytes).
; Stable backwards allocation matters: do not sort events or copy the live table.
; IDs are declared in 01_State.ERH. All game callbacks have explicit truth values.
@Z_CLOCK_CLEAR
VARSET Z_Q_ROUTINE
VARSET Z_Q_ENABLED
VARSET Z_Q_TICK
Z_Q_FIRST = 30
Z_Q_DEMONS = 30
Z_CLOCK_WAIT = 0
Z_CLOCK_DEPTH = 0
RETURN

@Z_CLOCK_INIT
CALL Z_CLOCK_CLEAR
Z_LAMP_STAGE = 0
Z_CANDLE_STAGE = 0
; GO registers these five in this exact order (the last is visited first).
CALL Z_SCHEDULE, ZE_FIGHT, -1
CALL Z_QUEUE, ZE_SWORD, -1
CALL Z_SCHEDULE, ZE_THIEF, -1
CALL Z_QUEUE, ZE_CANDLES, 40
CALL Z_QUEUE, ZE_LANTERN, 200
RETURN

@Z_INT(Z_ID, Z_DEMON = 0)
#DIM DYNAMIC Z_ID
#DIM DYNAMIC Z_DEMON
#DIM DYNAMIC Z_POS
FOR Z_POS, Z_Q_FIRST, 30
    SIF Z_Q_ROUTINE:Z_POS == Z_ID
        RETURN Z_POS
NEXT
; Source would write outside its table when exhausted; fail explicitly instead.
IF Z_Q_FIRST == 0 || Z_ID <= 0
    THROW Zork event table capacity or identifier error.
ENDIF
Z_Q_FIRST -= 1
SIF Z_DEMON
    Z_Q_DEMONS -= 1
Z_Q_ROUTINE:Z_Q_FIRST = Z_ID
RETURN Z_Q_FIRST

@Z_QUEUE(Z_ID, Z_TICKS)
#DIM DYNAMIC Z_ID
#DIM DYNAMIC Z_TICKS
#DIM DYNAMIC Z_POS
CALL Z_INT, Z_ID
Z_POS = RESULT
; PUT stores a 16-bit word in the source Z-machine.
Z_Q_TICK:Z_POS = Z_WORD_SIGNED(Z_TICKS)
CALL Z_CLOCK_ALIAS, Z_POS
RETURN Z_POS

@Z_ENABLE(Z_ID, Z_ON = 1)
#DIM DYNAMIC Z_ID
#DIM DYNAMIC Z_ON
#DIM DYNAMIC Z_POS
CALL Z_INT, Z_ID
Z_POS = RESULT
Z_Q_ENABLED:Z_POS = Z_ON != 0
CALL Z_CLOCK_ALIAS, Z_POS
RETURN Z_POS

@Z_SCHEDULE(Z_ID, Z_TICKS)
#DIM DYNAMIC Z_ID
#DIM DYNAMIC Z_TICKS
CALL Z_QUEUE, Z_ID, Z_TICKS
CALL Z_ENABLE, Z_ID
RETURN RESULT

@Z_CLOCK_SLOT(Z_ID)
#FUNCTION
#DIM DYNAMIC Z_ID
#DIM DYNAMIC Z_POS
FOR Z_POS, Z_Q_FIRST, 30
    SIF Z_Q_ROUTINE:Z_POS == Z_ID
        RETURNF Z_POS
NEXT
RETURNF -1

@Z_WORD_SIGNED(Z_WORD)
#FUNCTION
#DIM DYNAMIC Z_WORD
Z_WORD &= 65535
SIF Z_WORD >= 32768
    Z_WORD -= 65536
RETURNF Z_WORD

@Z_CLOCKER(Z_PARSED = 1)
#DIM DYNAMIC Z_PARSED
#DIM DYNAMIC Z_POS
#DIM DYNAMIC Z_OLD
#DIM DYNAMIC Z_EVENT
IF Z_CLOCK_WAIT
    Z_CLOCK_WAIT = 0
    RETURN 0
ENDIF
Z_CLOCK_DEPTH += 1
; This cursor is call-local. Nested CLOCKER must not overwrite its caller.
IF Z_PARSED
    Z_POS = Z_Q_FIRST
ELSE
    Z_POS = Z_Q_DEMONS
ENDIF
WHILE Z_POS < 30
    IF Z_Q_ENABLED:Z_POS
        Z_OLD = Z_Q_TICK:Z_POS
        IF Z_OLD != 0
            Z_Q_TICK:Z_POS = Z_WORD_SIGNED(Z_OLD - 1)
            CALL Z_CLOCK_PROGRESS, Z_POS
            IF Z_OLD <= 1
                CALL Z_CLOCK_DISPATCH, Z_Q_ROUTINE:Z_POS
                SIF RESULT != 0
                    Z_EVENT = 1
            ENDIF
        ENDIF
    ENDIF
    Z_POS += 1
WEND
Z_MOVES = Z_WORD_SIGNED(Z_MOVES + 1)
Z_CLOCK_DEPTH -= 1
RETURN Z_EVENT

@Z_CLOCK_PROGRESS(Z_POS)
#DIM DYNAMIC Z_POS
; Compatibility observations are derived from the authoritative queue.
; Lamp/candle elapsed time remains useful to examine exhausted objects.
IF Z_Q_ROUTINE:Z_POS == ZE_LANTERN
    Z_LAMP_TICKS += 1
ELSEIF Z_Q_ROUTINE:Z_POS == ZE_CANDLES
    Z_CANDLE_TICKS += 1
ENDIF
CALL Z_CLOCK_ALIAS, Z_POS
RETURN

@Z_CLOCK_ALIAS(Z_POS)
#DIM DYNAMIC Z_POS
#DIM DYNAMIC Z_COUNT
#DIM DYNAMIC Z_ON
Z_COUNT = MAX(0, Z_Q_TICK:Z_POS)
Z_ON = Z_Q_ENABLED:Z_POS
SELECTCASE Z_Q_ROUTINE:Z_POS
CASE ZE_LANTERN
    Z_LAMP_ENABLED = Z_ON
CASE ZE_CANDLES
    Z_CANDLE_ACTIVE = Z_ON
CASE ZE_THIEF
    Z_THIEF_ACTIVE = Z_ON
CASE ZE_SWORD
    Z_SWORD_ENABLED = Z_ON
CASE ZE_CYCLOPS
    Z_CYCLOPS_ACTIVE = Z_ON
CASE ZE_MATCH
    Z_MATCH_TIMER = Z_ON * Z_COUNT
CASE ZE_CURE
    Z_CURE_TIMER = Z_ON * Z_COUNT
CASE ZE_XB
    Z_XB_TIMER = Z_ON * Z_COUNT
CASE ZE_XC
    Z_XC_TIMER = Z_ON * Z_COUNT
CASE ZE_XBH
    Z_HOTBELL_TIMER = Z_ON * Z_COUNT
CASE ZE_RIVER
    Z_RIVER_TIMER = Z_ON * Z_COUNT
CASE ZE_RFILL
    SIF !Z_GATES_OPEN
        Z_DAM_TIMER = Z_ON * Z_COUNT
CASE ZE_REMPTY
    SIF Z_GATES_OPEN
        Z_DAM_TIMER = Z_ON * Z_COUNT
ENDSELECT
RETURN

@Z_CLOCK_DISPATCH(Z_ID)
#DIM DYNAMIC Z_ID
SELECTCASE Z_ID
CASE ZE_FOREST
    CALL Z_I_FOREST
CASE ZE_FIGHT
    CALL Z_FIGHT_CLOCK
CASE ZE_SWORD
    CALL Z_SWORD_CLOCK
CASE ZE_THIEF
    CALL Z_THIEF_CLOCK
CASE ZE_CURE
    CALL Z_I_CURE
CASE ZE_CYCLOPS
    IF Z_CYCLOPS_SLEEP || Z_DEAD
        RETURN 1
    ENDIF
    CALL Z_CYCLOPS_CLOCK
CASE ZE_RIVER
    CALL Z_I_RIVER
CASE ZE_RFILL
    CALL Z_I_RESERVOIR, 0
CASE ZE_REMPTY
    CALL Z_I_RESERVOIR, 1
CASE ZE_MAINT
    CALL Z_I_MAINT
CASE ZE_MATCH
    Z_FLAGS:O_MATCH &= ~(ZF_FLAME | ZF_ON)
    PRINTL The match has gone out.
    RETURN 1
CASE ZE_CANDLES
    CALL Z_I_CANDLES
CASE ZE_LANTERN
    CALL Z_I_LANTERN
CASE ZE_XB
    CALL Z_I_XB
CASE ZE_XC
    Z_EXORCISM_CANDLES = 0
    CALL Z_I_XB
CASE ZE_XBH
    CALL Z_MOVE_OBJECT, O_HOT_BELL, 0
    CALL Z_MOVE_OBJECT, O_BELL, R_ENTRANCE_TO_HADES
    IF Z_HERE == R_ENTRANCE_TO_HADES
        PRINTL The bell appears to have cooled down.
        RETURN 1
    ENDIF
    RETURN 0
CASEELSE
    THROW Zork unimplemented clock callback.
ENDSELECT
RETURN RESULT

@Z_I_XB
IF !Z_EXORCISM_CANDLES && Z_HERE == R_ENTRANCE_TO_HADES
    PRINTL The tension of this ceremony is broken, and the wraiths, amused but
    PRINTL shaken at your clumsy attempt, resume their hideous jeering.
ENDIF
Z_EXORCISM_BELL = 0
; Last source expression is SETG XB <>, so this does NOT interrupt WAIT.
RETURN 0

@Z_I_LANTERN
#DIM DYNAMIC Z_NEXT_INTERVAL
SELECTCASE Z_LAMP_STAGE
CASE 0
    Z_NEXT_INTERVAL = 100
CASE 1
    Z_NEXT_INTERVAL = 70
CASE 2
    Z_NEXT_INTERVAL = 15
CASEELSE
    Z_NEXT_INTERVAL = 0
    Z_FLAGS:O_LAMP &= ~ZF_ON
ENDSELECT
CALL Z_SCHEDULE, ZE_LANTERN, Z_NEXT_INTERVAL
IF Z_WITHIN(O_LAMP, Z_PLAYER) || Z_PARENT:O_LAMP == Z_HERE
    SELECTCASE Z_LAMP_STAGE
    CASE 0
        PRINTL The lamp appears a bit dimmer.
    CASE 1
        PRINTL The lamp is definitely dimmer now.
    CASE 2
        PRINTL The lamp is nearly out.
    CASEELSE
        PRINTL You'd better have more light than from the brass lantern.
    ENDSELECT
ENDIF
Z_LAMP_STAGE += 1
; I-LANTERN returns the advanced table pointer only for a nonzero interval.
RETURN Z_NEXT_INTERVAL != 0

@Z_I_CANDLES
#DIM DYNAMIC Z_NEXT_INTERVAL
Z_TOUCHED:O_CANDLES = 1
SELECTCASE Z_CANDLE_STAGE
CASE 0
    Z_NEXT_INTERVAL = 20
CASE 1
    Z_NEXT_INTERVAL = 10
CASE 2
    Z_NEXT_INTERVAL = 5
CASEELSE
    Z_NEXT_INTERVAL = 0
    Z_FLAGS:O_CANDLES &= ~ZF_ON
ENDSELECT
CALL Z_SCHEDULE, ZE_CANDLES, Z_NEXT_INTERVAL
IF Z_WITHIN(O_CANDLES, Z_PLAYER) || Z_PARENT:O_CANDLES == Z_HERE
    SELECTCASE Z_CANDLE_STAGE
    CASE 0
        PRINTL The candles grow shorter.
    CASE 1
        PRINTL The candles are becoming quite short.
    CASE 2
        PRINTL The candles won't last long now.
    CASEELSE
        PRINTL You'd better have more light than from the pair of candles.
    ENDSELECT
ENDIF
Z_CANDLE_STAGE += 1
RETURN Z_NEXT_INTERVAL != 0

@Z_I_CURE
IF Z_HERO_WOUND < 0
    Z_HERO_WOUND += 1
ELSE
    Z_HERO_WOUND = 0
ENDIF
IF Z_HERO_WOUND < 0
    SIF Z_LOAD_LIMIT < 100
        Z_LOAD_LIMIT += 10
    CALL Z_SCHEDULE, ZE_CURE, 30
    RETURN 1
ENDIF
Z_LOAD_LIMIT = 100
CALL Z_ENABLE, ZE_CURE, 0
RETURN 0

@Z_CLOCK_REMAIN(Z_ID)
#FUNCTION
#DIM DYNAMIC Z_ID
#DIM DYNAMIC Z_POS
Z_POS = Z_CLOCK_SLOT(Z_ID)
SIF Z_POS < 0
    RETURNF 0
RETURNF MAX(0, Z_Q_TICK:Z_POS) * Z_Q_ENABLED:Z_POS

@Z_CLOCK_ENABLED(Z_ID)
#FUNCTION
#DIM DYNAMIC Z_ID
#DIM DYNAMIC Z_POS
Z_POS = Z_CLOCK_SLOT(Z_ID)
SIF Z_POS < 0
    RETURNF 0
RETURNF Z_Q_ENABLED:Z_POS

@Z_CLOCK_VALIDATE
#DIM DYNAMIC Z_I
#DIM DYNAMIC Z_J
#DIM DYNAMIC Z_END
IF Z_Q_FIRST < 0 || Z_Q_FIRST > 25 || Z_Q_DEMONS != 30 || Z_CLOCK_WAIT != 0
    RETURN 0
ENDIF
FOR Z_I, 0, Z_Q_FIRST
    SIF Z_Q_ROUTINE:Z_I || Z_Q_ENABLED:Z_I || Z_Q_TICK:Z_I
        RETURN 0
NEXT
FOR Z_I, Z_Q_FIRST, 30
    IF Z_Q_ROUTINE:Z_I < 1 || Z_Q_ROUTINE:Z_I > 16 || Z_Q_ENABLED:Z_I < 0 || Z_Q_ENABLED:Z_I > 1 || Z_Q_TICK:Z_I < -32768 || Z_Q_TICK:Z_I > 32767
        RETURN 0
    ENDIF
    FOR Z_J, Z_I + 1, 30
        SIF Z_Q_ROUTINE:Z_I == Z_Q_ROUTINE:Z_J
            RETURN 0
    NEXT
NEXT
FOR Z_I, 1, 6
    SIF Z_Q_ROUTINE:(30 - Z_I) != Z_I
        RETURN 0
NEXT
SIF Z_LAMP_STAGE < 0 || Z_LAMP_STAGE > 4 || Z_CANDLE_STAGE < 0 || Z_CANDLE_STAGE > 4
    RETURN 0
SELECTCASE Z_LAMP_STAGE
CASE 0
    Z_END = 200
CASE 1
    Z_END = 300
CASE 2
    Z_END = 370
CASEELSE
    Z_END = 385
ENDSELECT
SIF Z_LAMP_TICKS + Z_Q_TICK:25 != Z_END
    RETURN 0
SELECTCASE Z_CANDLE_STAGE
CASE 0
    Z_END = 40
CASE 1
    Z_END = 60
CASE 2
    Z_END = 70
CASEELSE
    Z_END = 75
ENDSELECT
SIF Z_CANDLE_TICKS + Z_Q_TICK:26 != Z_END
    RETURN 0
SIF Z_LAMP_ENABLED != Z_CLOCK_ENABLED(ZE_LANTERN)
    RETURN 0
SIF Z_CANDLE_ACTIVE != Z_CLOCK_ENABLED(ZE_CANDLES)
    RETURN 0
SIF Z_THIEF_ACTIVE != Z_CLOCK_ENABLED(ZE_THIEF)
    RETURN 0
SIF Z_SWORD_ENABLED != Z_CLOCK_ENABLED(ZE_SWORD)
    RETURN 0
SIF Z_CYCLOPS_ACTIVE != Z_CLOCK_ENABLED(ZE_CYCLOPS)
    RETURN 0
SIF Z_CURE_TIMER != Z_CLOCK_REMAIN(ZE_CURE)
    RETURN 0
SIF Z_MATCH_TIMER != Z_CLOCK_REMAIN(ZE_MATCH)
    RETURN 0
SIF Z_XB_TIMER != Z_CLOCK_REMAIN(ZE_XB)
    RETURN 0
SIF Z_XC_TIMER != Z_CLOCK_REMAIN(ZE_XC)
    RETURN 0
SIF Z_HOTBELL_TIMER != Z_CLOCK_REMAIN(ZE_XBH)
    RETURN 0
SIF Z_RIVER_TIMER != Z_CLOCK_REMAIN(ZE_RIVER)
    RETURN 0
IF Z_GATES_OPEN
    SIF Z_DAM_TIMER != Z_CLOCK_REMAIN(ZE_REMPTY)
        RETURN 0
ELSE
    SIF Z_DAM_TIMER != Z_CLOCK_REMAIN(ZE_RFILL)
        RETURN 0
ENDIF
RETURN 1
