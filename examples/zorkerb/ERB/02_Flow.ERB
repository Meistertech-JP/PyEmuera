; Emuera owns TITLE -> FIRST -> SHOP and post-load entry.
; BEGIN and LOADDATA execute only at the owning system-function level.
@SYSTEM_TITLE
PRINTL ZORK I: The Great Underground Empire
PRINTL ZORKERB r29 -- Native eraBASIC port
PRINTL Original game: Infocom.
IF Z_RESTART_REQUEST
    Z_RESTART_REQUEST = 0
    RESETDATA
    CALL Z_LOAD_METADATA
    CALL Z_LOAD_GRAMMAR
    CALL Z_LOAD_SYNTAX_METADATA
    CALL Z_LOAD_COMBAT_TEXT
    CALL Z_LOAD_THIEF_TEXT
    CALL Z_NEW_GAME
    BEGIN FIRST
ENDIF
$TITLE_MENU
PRINTL [0] New game  [1] Restore  [9] Quit
INPUT
SELECTCASE RESULT
CASE 0
    RESETDATA
    CALL Z_LOAD_METADATA
    CALL Z_LOAD_GRAMMAR
    CALL Z_LOAD_SYNTAX_METADATA
    CALL Z_LOAD_COMBAT_TEXT
    CALL Z_LOAD_THIEF_TEXT
    CALL Z_NEW_GAME
    BEGIN FIRST
CASE 1
    PRINTL Save slot (0-9):
    INPUT
    IF RESULT < 0 || RESULT > 9
        PRINTL Invalid slot.
        GOTO TITLE_MENU
    ENDIF
    Z_SLOT = RESULT
    CHKDATA Z_SLOT
    ; Host title menu (not story text): explicit host diagnostics.
    IF RESULT == 0
        LOADDATA Z_SLOT
        PRINTL Restore failed.
    ELSE
        PRINTL No compatible save in that slot.
    ENDIF
CASE 9
    QUIT
ENDSELECT
GOTO TITLE_MENU

@EVENTFIRST
; @EVENTFIRST must not fall through. Initialisation has already completed.
BEGIN SHOP

@EVENTSHOP
RETURN

@SYSTEM_AUTOSAVE
; Zork saves only when explicitly requested.
RETURN

@SHOW_SHOP
; This is BOTH the new-game and post-LOADDATA input owner. Never RETURN into
; Emuera's numeric shop input, and never BEGIN from a nested ordinary CALL.
$Z_PROMPT
CALL Z_READ_TURN
SELECTCASE Z_CONTROL
CASE ZC_SAVE
    DUMPRAND
    SAVEDATA Z_SLOT, "Zork ERB r29"
    CHKDATA Z_SLOT
    ; V-SAVE: "Ok." / "Failed." (the file dialogue is host slot 0-9).
    IF RESULT == 0
        PRINTL Ok.
    ELSE
        PRINTL Failed.
    ENDIF
CASE ZC_LOAD
    CHKDATA Z_SLOT
    ; V-RESTORE failure is "Failed."; success resumes in EVENTLOAD ("Ok.").
    IF RESULT == 0
        LOADDATA Z_SLOT
    ENDIF
    PRINTL Failed.
CASE ZC_RESTART
    Z_RESTART_REQUEST = 1
    BEGIN TITLE
CASE ZC_QUIT
    QUIT
ENDSELECT
GOTO Z_PROMPT

@EVENTLOAD
IF Z_SCHEMA != 29
    PRINTL This save uses an unsupported Zork ERB state schema.
    Z_RESTART_REQUEST = 0
    BEGIN TITLE
ENDIF
IF (Z_AFTER_SAY != 0 && Z_AFTER_SAY != 1) || (Z_QUOTE_STREAM != 0 && Z_QUOTE_STREAM != 1) || (Z_OOPS_QUOTED != 0 && Z_OOPS_QUOTED != 1)
    PRINTL This save has an invalid Zork parser state.
    Z_RESTART_REQUEST = 0
    BEGIN TITLE
ENDIF
IF Z_OOPS_ACTOR != 0 && Z_OOPS_ACTOR != O_CYCLOPS
    PRINTL This save has an invalid Zork parser state.
    Z_RESTART_REQUEST = 0
    BEGIN TITLE
ENDIF
; Immutable metadata may be rebuilt, but saved mutable linkage must not be repaired.
CALL Z_LOAD_METADATA
CALL Z_PSEUDO_VALIDATE
IF !RESULT
    PRINTL This save has an invalid Zork pseudo state.
    Z_RESTART_REQUEST = 0
    BEGIN TITLE
ENDIF
CALL Z_TREE_VALIDATE
IF !RESULT
    PRINTL This save has an invalid Zork object tree.
    Z_RESTART_REQUEST = 0
    BEGIN TITLE
ENDIF
Z_CLOCK_DEPTH = 0
CALL Z_CLOCK_VALIDATE
IF !RESULT
    PRINTL This save has an invalid Zork event table.
    Z_RESTART_REQUEST = 0
    BEGIN TITLE
ENDIF
CALL Z_DUMMY_VALIDATE
IF !RESULT
    PRINTL This save has an invalid Zork random table.
    Z_RESTART_REQUEST = 0
    BEGIN TITLE
ENDIF
CALL Z_YUKS_VALIDATE
IF !RESULT
    PRINTL This save has an invalid Zork random table.
    Z_RESTART_REQUEST = 0
    BEGIN TITLE
ENDIF
CALL Z_HOHUM_VALIDATE
IF !RESULT
    PRINTL This save has an invalid Zork random table.
    Z_RESTART_REQUEST = 0
    BEGIN TITLE
ENDIF
CALL Z_SKIP_VALIDATE
IF !RESULT
    PRINTL This save has an invalid Zork random table.
    Z_RESTART_REQUEST = 0
    BEGIN TITLE
ENDIF
CALL Z_JUMP_VALIDATE
IF !RESULT
    PRINTL This save has an invalid Zork random table.
    Z_RESTART_REQUEST = 0
    BEGIN TITLE
ENDIF
IF !Z_RANDOM_VALIDATE()
    PRINTL This save has an invalid Zork random table.
    Z_RESTART_REQUEST = 0
    BEGIN TITLE
ENDIF
; DO NOT call Z_NEW_GAME here. Rebind only metadata and clear scratch state.
CALL Z_LOAD_METADATA
CALL Z_LOAD_GRAMMAR
CALL Z_LOAD_SYNTAX_METADATA
CALL Z_LOAD_COMBAT_TEXT
CALL Z_LOAD_THIEF_TEXT
CALL Z_RESET_TRANSIENT
CALL Z_PSEUDO_REBIND
INITRAND
; The restored story resumes in V-SAVE's success branch: "Ok.".
PRINTL Ok.
RETURN

