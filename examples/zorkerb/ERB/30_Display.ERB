PRINTFORML @@LATE|{Z_THIEF_STRENGTH}|{Z_THIEF_ACTIVE}|{Z_THIEF_HERE}|{Z_THIEF_FIGHT}|{Z_THIEF_STAGGER}|{Z_THIEF_WAKE}|{Z_THIEF_ENGROSSED}|{Z_EGG_SOLVED}|{Z_EGG_ATTEMPT}|{Z_SING_SONG}|{Z_DEATHS}|{Z_DEAD}|{Z_WON}|{Z_FINISHED}|{Z_LAMP_ENABLED}|{Z_SWORD_ENABLED}
PRINTFORML @@SCORECACHE|{Z_CASE_SCORE}|{Z_CASE_TOTAL()}
PRINTFORML @@CONVERSATION|{Z_ACTOR}|{Z_HELLO_COUNT}|{Z_HELLO_ORDER:0}|{Z_HELLO_ORDER:1}|{Z_HELLO_ORDER:2}|{Z_HELLO_ORDER:3}
PRINTFORML @@HOHUM|{Z_HOHUM_COUNT}|{Z_HOHUM_ORDER:0}|{Z_HOHUM_ORDER:1}|{Z_HOHUM_ORDER:2}
PRINTFORML @@SKIP|{Z_SKIP_COUNT}|{Z_SKIP_ORDER:0}|{Z_SKIP_ORDER:1}|{Z_SKIP_ORDER:2}|{Z_SKIP_ORDER:3}
FOR Z_I, 1, Z_OBJECT_COUNT + 1
    PRINTFORML @@TVALUE|{Z_I}|{Z_CURRENT_TVALUE:Z_I}
NEXT
PRINTFORML @@CLOCK|{Z_Q_FIRST}|{Z_Q_DEMONS}|{Z_CLOCK_WAIT}|{Z_LAMP_STAGE}|{Z_CANDLE_STAGE}
FOR LOCAL, Z_Q_FIRST, 30
    PRINTFORML @@EVENT|{LOCAL}|{Z_Q_ROUTINE:LOCAL}|{Z_Q_ENABLED:LOCAL}|{Z_Q_TICK:LOCAL}
