FOR Z_I, 1, Z_OBJECT_COUNT + 1
    PRINTFORML @@OBJ|{Z_I}|{Z_PARENT:Z_I}|{Z_FLAGS:Z_I}|{Z_TOUCHED:Z_I}|{Z_VALUE_AWARDED:Z_I}
