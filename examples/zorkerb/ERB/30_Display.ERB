@Z_LOOK(Z_FORCE)
#DIM DYNAMIC Z_FORCE
#DIM DYNAMIC Z_O
#DIM DYNAMIC Z_LINK_CURSOR1
IF !Z_IS_LIT()
    PRINTL It is pitch black. You are likely to be eaten by a grue.
    RETURN
ENDIF
; DESCRIBE-ROOM: D ,HERE, then ", in the <vehicle>" when the winner is in one.
IF Z_IN_BOAT
    PRINTFORML %Z_ROOM_NAME:Z_HERE%, in the %Z_OBJ_NAME:O_INFLATED_BOAT%
ELSE
    PRINTFORML %Z_ROOM_NAME:Z_HERE%
ENDIF
IF Z_FORCE || (Z_VERBOSE != 0 && (!Z_VISITED:Z_HERE || Z_VERBOSE == 2))
    CALL Z_DESCRIBE_ROOM
ENDIF
Z_VISITED:Z_HERE = 1
; DESCRIBE-ROOM clears TOUCHBIT again for MAZEBIT rooms.
SIF Z_ROOM_MAZE:Z_HERE
    Z_VISITED:Z_HERE = 0
SIF !Z_FORCE && Z_VERBOSE == 0
    RETURN
; DESCRIBE-OBJECTS: PRINT-CONT of the room at level -1.
SIF Z_FIRST_CHILD(Z_HERE)
    CALL Z_PRINT_CONT, Z_HERE, -1
RETURN

@Z_OBJECT_DESCFCN(Z_O)
#DIM DYNAMIC Z_O
; Original Zork I BAT has DESCFCN BAT-D. Room descriptions do not own
; the bat paragraph; object order remains governed by Z_FIRST/Z_NEXT.
IF Z_O == O_BAT
    CALL Z_BAT_DESCRIPTION
    RETURN 1
ENDIF
RETURN 0

; V-INVENTORY
@Z_INVENTORY
IF Z_FIRST_CHILD(Z_PLAYER)
    CALL Z_PRINT_CONT, Z_PLAYER, 0
ELSE
    PRINTL You are empty-handed.
ENDIF
RETURN

@Z_DESCRIBE_ROOM
CALL Z_DESCRIBE_REGIONS
SIF RESULT
    RETURN
CALL Z_DESCRIBE_EAST
SIF RESULT
    RETURN
SELECTCASE Z_HERE
CASE R_WEST_OF_HOUSE
    PRINTL You are standing in an open field west of a white house, with a boarded
    PRINT front door.
    SIF Z_WON
        PRINT  A secret path leads southwest into the forest.
    PRINTL
CASE R_EAST_OF_HOUSE
    PRINTL You are behind the white house. A path leads into the forest
    PRINTL to the east. In one corner of the house there is a small window
    PRINT which is 
    IF Z_HAS(O_KITCHEN_WINDOW, ZF_OPEN)
        PRINTL open.
    ELSE
        PRINTL slightly ajar.
    ENDIF
CASE R_KITCHEN
    PRINTL You are in the kitchen of the white house. A table seems to
    PRINTL have been used recently for the preparation of food. A passage
    PRINTL leads to the west and a dark staircase can be seen leading
    PRINTL upward. A dark chimney leads down and to the east is a small
    PRINT window which is 
    IF Z_HAS(O_KITCHEN_WINDOW, ZF_OPEN)
        PRINTL open.
    ELSE
        PRINTL slightly ajar.
    ENDIF
CASE R_LIVING_ROOM
    PRINT You are in the living room. There is a doorway to the east
    IF Z_MAGIC_FLAG
        PRINTL . To the
        PRINTL west is a cyclops-shaped opening in an old wooden door, above which is
        PRINT some strange gothic lettering, 
    ELSE
        PRINTL , a wooden
        PRINTL door with strange gothic lettering to the west, which appears to be
        PRINT nailed shut, 
    ENDIF
    PRINT a trophy case, 
    IF Z_RUG_MOVED && Z_HAS(O_TRAP_DOOR, ZF_OPEN)
        PRINTL and a rug lying beside an open trap door.
    ELSEIF Z_RUG_MOVED
        PRINTL and a closed trap door at your feet.
    ELSEIF Z_HAS(O_TRAP_DOOR, ZF_OPEN)
        PRINTL and an open trap door at your feet.
    ELSE
        PRINTL and a large oriental rug in the center of the room.
    ENDIF
CASE R_GRATING_CLEARING
    PRINTL You are in a clearing, with a forest surrounding you on all sides. A
    PRINTL path leads south.
    IF Z_HAS(O_GRATE, ZF_OPEN)
        PRINTL There is an open grating, descending into darkness.
    ELSEIF Z_GRATE_REVEALED
        PRINTL There is a grating securely fastened into the ground.
    ENDIF
CASE R_GRATING_ROOM
    PRINTL You are in a small room near the maze. There are twisty passages
    PRINTL in the immediate vicinity.
    IF Z_HAS(O_GRATE, ZF_OPEN)
        PRINTL Above you is an open grating with sunlight pouring in.
    ELSEIF Z_GRATE_UNLOCKED
        PRINTL Above you is a grating.
    ELSE
        PRINTL Above you is a grating locked with a skull-and-crossbones lock.
    ENDIF
CASE R_CYCLOPS_ROOM
    PRINTL This room has an exit on the northwest, and a staircase leading up.
    IF Z_MAGIC_FLAG
        PRINTL The east wall, previously solid, now has a cyclops-sized opening in it.
    ELSEIF Z_CYCLOPS_SLEEP
        PRINTL The cyclops is sleeping blissfully at the foot of the stairs.
    ELSEIF Z_CYCLOPS_HUNGER == 0
        PRINTL A cyclops, who looks prepared to eat horses (much less mere
        PRINTL adventurers), blocks the staircase. From his state of health, and
        PRINTL the bloodstains on the walls, you gather that he is not very
        PRINTL friendly, though he likes people.
    ELSEIF Z_CYCLOPS_HUNGER > 0
        PRINTL The cyclops is standing in the corner, eyeing you closely. I don't
        PRINTL think he likes you very much. He looks extremely hungry, even for a
        PRINTL cyclops.
    ELSE
        PRINTL The cyclops, having eaten the hot peppers, appears to be gasping.
        PRINTL His enflamed tongue protrudes from his man-sized mouth.
    ENDIF
CASE R_UP_A_TREE
    PRINTL You are about 10 feet above the ground nestled among some large
    PRINTL branches. The nearest branch above you is above your reach.
    ; TREE-ROOM M-LOOK: PATH with at least two children
    IF Z_FIRST_CHILD(R_PATH) && Z_NEXT:(Z_FIRST_CHILD(R_PATH))
        PRINT On the ground below you can see:  
        CALL Z_PRINT_CONTENTS, R_PATH
        PRINTL .
    ENDIF
CASEELSE
    PRINTVL Z_ROOM_DESC:Z_HERE
ENDSELECT
RETURN

; The SCORE verb: DEAD-FUNCTION answers it while dead.
@Z_SCORE
IF Z_DEAD
    PRINTL You're dead! How can you think of your score?
    RETURN
ENDIF
CALL Z_V_SCORE
RETURN

; V-SCORE itself, also called directly by FINISH, V-QUIT and V-RESTART.
@Z_V_SCORE
#DIM DYNAMIC Z_S
Z_S = Z_TOTAL_SCORE()
PRINTFORM Your score is {Z_S} (total of 350 points), in {Z_MOVES}
IF Z_MOVES == 1
    PRINTL  move.
ELSE
    PRINTL  moves.
ENDIF
PRINT This gives you the rank of 
IF Z_S == 350
    PRINT Master Adventurer
ELSEIF Z_S > 330
    PRINT Wizard
ELSEIF Z_S > 300
    PRINT Master
ELSEIF Z_S > 200
    PRINT Adventurer
ELSEIF Z_S > 100
    PRINT Junior Adventurer
ELSEIF Z_S > 50
    PRINT Novice Adventurer
ELSEIF Z_S > 25
    PRINT Amateur Adventurer
ELSE
    PRINT Beginner
ENDIF
PRINTL .
RETURN

