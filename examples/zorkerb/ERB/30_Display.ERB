; ---------------------------------------------------------------------------
; r29: gverbs.zil PRINT-CONT, FIRSTER, DESCRIBE-OBJECT and SEE-INSIDE?,
; transcribed branch for branch (including the commented-out 1ST? update that
; makes a level-0 "There is a ... here." follow an FDESC-described sibling).
; INVISIBLE is ZF_HIDDEN, TOUCHBIT is Z_TOUCHED, the player is Z_PLAYER and is
; never a child; a vehicle the player is in is the inflated boat (Z_IN_BOAT).

@Z_SEE_INSIDE(Z_O)
#FUNCTION
#DIM DYNAMIC Z_O
RETURNF !Z_HAS(Z_O, ZF_HIDDEN) && (Z_HAS(Z_O, ZF_TRANSPARENT) || Z_HAS(Z_O, ZF_OPEN))

@Z_INDENT(Z_LEVEL)
#DIM DYNAMIC Z_LEVEL
#DIM DYNAMIC Z_I
FOR Z_I, 0, Z_LEVEL
    PRINT   
NEXT
RETURN

@Z_PRINT_CONT(Z_OBJ, Z_LEVEL)
#DIM DYNAMIC Z_OBJ
#DIM DYNAMIC Z_LEVEL
#DIM DYNAMIC Z_Y
#DIM DYNAMIC Z_AV
#DIM DYNAMIC Z_1ST
#DIM DYNAMIC Z_SHIT
#DIM DYNAMIC Z_PV
#DIM DYNAMIC Z_INV
SIF !Z_FIRST_CHILD(Z_OBJ)
    RETURN 1
Z_AV = 0
SIF Z_IN_BOAT
    Z_AV = O_INFLATED_BOAT
Z_1ST = 1
Z_SHIT = 1
IF Z_OBJ == Z_PLAYER || (Z_OBJ > 0 && Z_OBJ < 256 && Z_PARENT:Z_OBJ == Z_PLAYER)
    Z_INV = 1
ELSE
    Z_Y = Z_FIRST_CHILD(Z_OBJ)
    WHILE Z_Y
        IF Z_Y == Z_AV
            Z_PV = 1
        ELSEIF !Z_HAS(Z_Y, ZF_HIDDEN) && !Z_TOUCHED:Z_Y && Z_FDESC:Z_Y != ""
            IF !Z_HAS(Z_Y, ZF_NDESC)
                PRINTVL Z_FDESC:Z_Y
                Z_SHIT = 0
            ENDIF
            IF Z_SEE_INSIDE(Z_Y) && Z_Y != O_BAT && Z_FIRST_CHILD(Z_Y)
                CALL Z_PRINT_CONT, Z_Y, 0
                SIF RESULT
                    Z_1ST = 0
            ENDIF
        ENDIF
        Z_Y = Z_NEXT:Z_Y
    WEND
ENDIF
Z_Y = Z_FIRST_CHILD(Z_OBJ)
WHILE Z_Y
    IF Z_Y == Z_AV
    ELSEIF !Z_HAS(Z_Y, ZF_HIDDEN) && (Z_INV || Z_TOUCHED:Z_Y || Z_FDESC:Z_Y == "")
        IF !Z_HAS(Z_Y, ZF_NDESC)
            IF Z_1ST
                CALL Z_FIRSTER, Z_OBJ, Z_LEVEL
                SIF RESULT && Z_LEVEL < 0
                    Z_LEVEL = 0
                Z_LEVEL += 1
                Z_1ST = 0
            ENDIF
            SIF Z_LEVEL < 0
                Z_LEVEL = 0
            CALL Z_DESCRIBE_OBJECT, Z_Y, Z_LEVEL
        ELSEIF Z_FIRST_CHILD(Z_Y) && Z_SEE_INSIDE(Z_Y)
            Z_LEVEL += 1
            CALL Z_PRINT_CONT, Z_Y, Z_LEVEL
            Z_LEVEL -= 1
        ENDIF
    ENDIF
    Z_Y = Z_NEXT:Z_Y
WEND
IF Z_PV && Z_AV && Z_FIRST_CHILD(Z_AV)
    Z_LEVEL += 1
    CALL Z_PRINT_CONT, Z_AV, Z_LEVEL
ENDIF
SIF Z_1ST && Z_SHIT
    RETURN 0
RETURN 1

; FIRSTER: the heading; returns whether one was printed (TELL is true).
@Z_FIRSTER(Z_OBJ, Z_LEVEL)
#DIM DYNAMIC Z_OBJ
#DIM DYNAMIC Z_LEVEL
IF Z_OBJ == O_TROPHY_CASE
    PRINTL Your collection of treasures consists of:
    RETURN 1
ELSEIF Z_OBJ == Z_PLAYER
    PRINTL You are carrying:
    RETURN 1
ELSEIF Z_OBJ > 0 && Z_OBJ < 256
    SIF Z_LEVEL > 0
        CALL Z_INDENT, Z_LEVEL
    IF Z_HAS(Z_OBJ, ZF_SURFACE)
        PRINTFORML Sitting on the %Z_OBJ_NAME:Z_OBJ% is: 
    ELSEIF Z_HAS(Z_OBJ, ZF_ACTOR)
        PRINTFORML The %Z_OBJ_NAME:Z_OBJ% is holding: 
    ELSE
        PRINTFORML The %Z_OBJ_NAME:Z_OBJ% contains:
    ENDIF
    RETURN 1
ENDIF
RETURN 0

@Z_DESCRIBE_OBJECT(Z_OBJ, Z_LEVEL)
#DIM DYNAMIC Z_OBJ
#DIM DYNAMIC Z_LEVEL
IF Z_LEVEL == 0
    ; DESCFCN BAT-D and the LDESC that 1actions.zil rewrites with PUTP.
    CALL Z_OBJECT_DESCFCN, Z_OBJ
    SIF RESULT
        RETURN
    IF Z_OBJ == O_TROLL
        CALL Z_TROLL_DESCRIPTION
    ELSEIF Z_OBJ == O_THIEF
        CALL Z_THIEF_DESCRIPTION
    ELSE
        IF !Z_TOUCHED:Z_OBJ && Z_FDESC:Z_OBJ != ""
            PRINTV Z_FDESC:Z_OBJ
        ELSEIF Z_OBJ == O_PAINTING && Z_CURRENT_TVALUE:O_PAINTING == 0
            PRINT There is a worthless piece of canvas here.
        ELSEIF Z_LDESC:Z_OBJ != ""
            PRINTV Z_LDESC:Z_OBJ
        ELSE
            PRINTFORM There is a %Z_OBJ_NAME:Z_OBJ% here
            SIF Z_HAS(Z_OBJ, ZF_ON)
                PRINT  (providing light)
            PRINT .
        ENDIF
        SIF Z_IN_BOAT
            PRINTFORM  (outside the %Z_OBJ_NAME:O_INFLATED_BOAT%)
        PRINTL
    ENDIF
ELSE
    CALL Z_INDENT, Z_LEVEL
    PRINTFORM A %Z_OBJ_NAME:Z_OBJ%
    SIF Z_HAS(Z_OBJ, ZF_ON)
        PRINT  (providing light)
    PRINTL
ENDIF
SIF Z_SEE_INSIDE(Z_OBJ) && Z_FIRST_CHILD(Z_OBJ)
    CALL Z_PRINT_CONT, Z_OBJ, Z_LEVEL
RETURN
