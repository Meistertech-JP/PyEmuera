PRINTFORML @@EXT|{Z_TROLL_STRENGTH}|{Z_TROLL_PASS}|{Z_TROLL_FIGHT}|{Z_TROLL_STAGGER}|{Z_TROLL_WAKE}|{Z_HERO_WOUND}|{Z_HERO_STAGGER}|{Z_CURE_TIMER}|{Z_LOAD_LIMIT}|{Z_GRATE_UNLOCKED}|{Z_CYCLOPS_HUNGER}|{Z_CYCLOPS_SLEEP}|{Z_MAGIC_FLAG}|{Z_GAME_OVER}|{Z_SWORD_GLOW}|{Z_CYCLOPS_ACTIVE}
PRINTFORML @@EAST|{Z_GATE_ENABLED}|{Z_GATES_OPEN}|{Z_LOW_TIDE}|{Z_DAM_TIMER}|{Z_WATER_LEVEL}|{Z_MAINT_LIGHT}|{Z_LOUD_SOLVED}|{Z_DOME_TIED}|{Z_MIRROR_BROKEN}|{Z_MATCH_COUNT}|{Z_MATCH_TIMER}|{Z_CANDLE_TICKS}|{Z_CANDLE_ACTIVE}|{Z_EXORCISM_BELL}|{Z_EXORCISM_CANDLES}|{Z_XB_TIMER}|{Z_XC_TIMER}|{Z_HOTBELL_TIMER}|{Z_LLD_OPEN}
PRINTFORML @@REGION|{Z_IN_BOAT}|{Z_RIVER_TIMER}|{Z_RAINBOW}|{Z_BUOY_HINT}|{Z_BEACH_DIG}|{Z_CAGE_TOP}|{Z_SHAFT_SCORED}|{Z_BAT_COUNT}
