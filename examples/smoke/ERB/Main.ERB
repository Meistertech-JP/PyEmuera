@SYSTEM_TITLE
PRINTL PyEmuera / ぱみゅーら 散歩帳
PRINTL 非成人向けの独立した動作確認デモです。
PRINTL [0] はじめる  [1] JSONセーブを読む  [9] 終了
INPUT
SELECTCASE RESULT
CASE 0
    RESETDATA
    ADDCHARA 0
    MASTER = 0
    TARGET = 0
    MONEY = START_MONEY
    ITEMSALES:地図 = 1
    BEGIN FIRST
CASE 1
    LOADGAME
    BEGIN TITLE
CASE 9
    QUIT
CASEELSE
    BEGIN TITLE
ENDSELECT

@EVENTFIRST
PRINTFORML %NAME%さん、%STR:挨拶%
BEGIN SHOP

@SHOW_SHOP
DRAWLINE
PRINTFORML 所持金 {MONEY} / 地図 {ITEM:地図}枚 / 散歩 {CFLAG:散歩回数}回
PRINT_SHOPITEM
PRINTL [100] 散歩に出る  [101] 保存  [102] 読込  [999] 終了
RETURN

@USERSHOP
SELECTCASE RESULT
CASE WALK_COMMAND
    BEGIN TRAIN
CASE 101
    SAVEGAME
CASE 102
    LOADGAME
CASE 999
    QUIT
CASEELSE
    PRINTL メニューの番号を入力してください。
ENDSELECT
RETURN

@EVENTBUY
PRINTFORML 地図を購入しました。残金 {MONEY}
RETURN

@SAVEINFO
SAVESTR = 散歩 {CFLAG:散歩回数}回、所持金 {MONEY}
RETURN

@EVENTLOAD
PRINTL PyEmueraのJSONセーブを読み込みました。
RETURN

@SHOW_STATUS
PRINTFORML 練習ポイント {PALAM:練習}
RETURN

@SHOW_USERCOM
PRINTL [100] 店に戻る
RETURN

@COM0
CFLAG:散歩回数 += 1
UP:練習 = 10
UPCHECK
PRINTL 公園を一周しました。
RETURN 1

@SOURCE_CHECK
RETURN

@USERCOM
SIF RESULT == 100
    BEGIN SHOP
RETURN
