@SYSTEM_TITLE
OR_TRACE=0
OR_IDX=-1
OR_ARR=3,7,0,0
PRINTFORML ORACLE|prior|int|{OR_TRACE}|{OR_IDX}|{OR_ARR:0}|{OR_ARR:3}
OUTPUTLOG
OR_ARR:OR_BAD_NEXT()+=OR_LEFT()
PRINTL ORACLE|unexpected_success
QUIT
@OR_LEFT
#FUNCTION
OR_TRACE=OR_TRACE*10+1
RETURNF 9
@OR_NEXT
#FUNCTION
OR_TRACE=OR_TRACE*10+2
OR_IDX+=1
RETURNF OR_IDX
@OR_OTHER
#FUNCTION
OR_TRACE=OR_TRACE*10+3
RETURNF 5
@OR_ZERO
#FUNCTION
OR_TRACE=OR_TRACE*10+3
RETURNF OR_DEN
@OR_STRING
#FUNCTIONS
OR_TRACE=OR_TRACE*10+1
RETURNF "X"
@OR_STRING2
#FUNCTIONS
OR_TRACE=OR_TRACE*10+3
RETURNF "Y"
@OR_MOVE
#FUNCTION
OR_TRACE=OR_TRACE*10+1
OR_IDX+=1
RETURNF 9
@OR_BAD_NEXT
#FUNCTION
OR_TRACE=OR_TRACE*10+2
OR_IDX+=1
RETURNF OR_IDX==0 ? 0 # 99
